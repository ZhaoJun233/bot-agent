{
  "id": "preset.feature.voice",
  "entryAssembly": "BotAgent.Package.Voice.dll",
  "entryType": "BotAgent.Packages.Voice.VoicePackagePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "permissions": [],
  "sharedContracts": [
    {
      "name": "BotAgent.Voice.Contracts",
      "owner": "preset.feature.voice"
    }
  ],
  "settings": [
    {
      "key": "sttEnabled",
      "label": "启用云端语音转写（STT）",
      "type": "boolean",
      "defaultValue": "false",
      "required": false
    },
    {
      "key": "sttEndpointUrl",
      "label": "STT 接口地址（留空自动拼接主模型根地址 /audio/transcriptions）",
      "type": "string",
      "defaultValue": "",
      "required": false
    },
    {
      "key": "sttModel",
      "label": "STT 模型名称",
      "type": "string",
      "defaultValue": "whisper-1",
      "required": false
    },
    {
      "key": "sttApiKey",
      "label": "STT 专用 API Key（留空回退主模型密钥）",
      "type": "secret",
      "defaultValue": null,
      "required": false
    },
    {
      "key": "sttMaxSeconds",
      "label": "单条语音最大允许时长（秒）",
      "type": "number",
      "defaultValue": "60",
      "required": false,
      "numberConstraints": {
        "minimum": 5,
        "maximum": 120,
        "integer": true
      }
    }
  ]
}
