{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": [],
    "paths": { "vue": ["./node_modules/vue"] },
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["*.ts", "*.vue", "../../../contracts/ui/index.ts"]
}
