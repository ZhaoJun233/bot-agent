{
  "id": "preset.feature.documents",
  "entryAssembly": "BotAgent.Package.Documents.dll",
  "entryType": "BotAgent.Packages.Documents.DocumentsPackagePlugin",
  "apiVersion": 1,
  "targetFramework": "net10.0",
  "toolApiVersion": 1,
  "permissions": [
    "network.public-read",
    "tools.execute"
  ],
  "sharedContracts": [
    {
      "name": "BotAgent.Documents.Contracts",
      "owner": "preset.feature.documents"
    }
  ],
  "settings": [
    {
      "key": "autoExtractInbound",
      "label": "入站附件自动提取首屏摘要",
      "type": "boolean",
      "defaultValue": "true",
      "required": false
    },
    {
      "key": "maxFileBytes",
      "label": "单文件最大字节数（上限 10 MiB）",
      "type": "number",
      "defaultValue": "10485760",
      "required": false,
      "numberConstraints": {
        "minimum": 65536,
        "maximum": 10485760,
        "integer": true
      }
    },
    {
      "key": "maxInlineChars",
      "label": "单次提取最大字符数",
      "type": "number",
      "defaultValue": "6000",
      "required": false,
      "numberConstraints": {
        "minimum": 500,
        "maximum": 12000,
        "integer": true
      }
    }
  ]
}
