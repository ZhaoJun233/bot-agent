# ══════════════════════════════════════════════════════════════
#  复制为 .env 后填写：cp .env.example .env
#  （.env 已在 .gitignore/.dockerignore 中，不会提交也不会进镜像）
#
#  ⚠ 两个常见坑：
#   1) .env **不会自动进容器** —— 它只用于 docker-compose.yml 里的 ${VAR} 替换。
#      新加变量必须同时在 compose 的 environment: 里声明。
#   2) 千万不要把仓库里的 docker-compose.yml 直接覆盖到部署目录 ——
#      部署目录里可能有手工加的条目（napcat 的 TZ / ACCOUNT），覆盖后会丢，
#      ACCOUNT 丢了 NapCat 就无法快速登录（表现为“掉登录、要重新扫码”）。
#      改 compose 时请先 diff。
# ══════════════════════════════════════════════════════════════

# ─────────── 必填 ───────────

# 模型 API Key（DeepSeek / OpenAI / 通义 / 自建中转…）
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 消息白名单：要接管的群号，或对机器人说话的 QQ 号；逗号分隔
#   （旧字段：群聊与私聊共用一份。2026-09-18 拆成了下面两份 ——
#    哪一边的新字段留空，那一边就回落到这份；两份都填了，这份不再起作用）
#   '*'  = 接收全部群/私聊（危险：模型会看到所有消息）
#   留空 = 严格模式，忽略全部消息（机器人不工作）
# 例：WHITELIST=123456789,987654321
WHITELIST=*

# 群聊白名单（只填群号；'*' = 所有群）—— 与私聊名单各管各的：
# QQ 号填在私聊名单里不会放行同号的群，群号填在群聊名单里也不会放行同号的私聊
WHITELIST_GROUPS=

# 私聊白名单（只填 QQ 号；'*' = 所有私聊）
WHITELIST_PRIVATES=

# ─────────── 模型 ───────────

MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MAX_TOKENS=2048

# ─────────── QQ ───────────

# 机器人 QQ 号（用于识别 @机器人；留空则连接后自动从协议端获取）
BOT_UIN=

# NapCat 的 Access Token（与 NapCat WebUI 里设置的一致；不用可留空）
ONEBOT_TOKEN=

# NapCat 容器内 Linux QQ 的运行用户（Linux 上填 `id -u` / `id -g` 的结果）
NAPCAT_UID=1000
NAPCAT_GID=1000

# ─────────── 机器人性格 ───────────

# 人设：性格 / 说话风格，每次请求都会注入
BOT_PERSONA=你是群里的老群友，说话简短、口语化，偶尔吐槽，不用客服腔。

# 对话欲望 0-100：越高越主动参与闲聊
AI_DESIRE=50

# 1=自动回复，0=只收消息不回复（调试用）
AI_MODE=1

# ─────────── 回复节奏（防刷屏） ───────────

# 同一会话的最小回复间隔（秒）
GROUP_COOLDOWN=8
PRIVATE_COOLDOWN=3

# 静默兜底：超过该秒数没有主动请求时补发一次判断；0=关闭
IDLE_FALLBACK=60

# 长回复按句分句发送，更像真人打字
SPLIT_REPLIES=1
SEGMENT_DELAY_MS=700

# ─────────── 记忆与并发（首次部署种子；之后由面板接管） ───────────
#
# ⚠ 本文件只用于 compose 的 ${VAR} 替换，**不会自动进容器**。
#   新增变量必须同时在 docker-compose.yml 的 environment 里声明，否则不生效。
#
# 下面这几个已有合理默认值，日常直接在 Web 面板「设置」页里改即可，
# 不需要（也不能）通过 .env 调。
#
#   QQCHAT_MAX_CONTEXT   给模型的最大上下文条数（默认 200）
#   QQCHAT_MAX_MESSAGES  单会话保留条数，超出归档到 archive/*.jsonl（默认 500）
#   QQCHAT_CONCURRENCY   同时向模型发起的最大请求数（默认 2）
#   QQCHAT_PROFILE_LOOKUP / PROFILE_LINES / PROFILE_CHARS  人物档案注入量与预算
#   QQCHAT_PROFILE_SUMMARY(_THRESHOLD/_CHARS/_INTERVAL)    长期画像（默认开）
#   QQCHAT_SUITABILITY_THRESHOLD  发言适合度阈值（默认 10，代码侧硬拦）
#   QQCHAT_IGNORE_BRACKETS  1 = 把群友的括号旁白标注成 〔旁白：…〕（不丢内容、不单独触发回复）

# ─────────── 运维 ───────────

# 面板访问令牌（可选）。设了之后打开面板要带 ?token=xxx（会自动记住）；
# /healthz 与 /readyz 不受影响。留空 = 不鉴权（仅回环访问时够用）。
# 公网暴露时，建议在外层反向代理（Caddy/nginx）上再加一道基础认证，两道门更安全。
PANEL_TOKEN=

# NapCat WebUI（面板内扫码登录用）。
# 填了它，机器人面板在“QQ 未登录”时会直接显示登录二维码 ——
# 不必再让人去开 NapCat 自己的 WebUI（另一域名 + 另一道认证）。
# 令牌值：cat napcat/config/webui.json | grep token
NAPCAT_WEBUI_URL=http://napcat:6099
NAPCAT_WEBUI_TOKEN=

# 表情包（全库共用一份存储，不分会话）。
# 行为类配置：settings.json 是唯一所有者，这里只在首次部署当种子。
#   STICKERS=0              关闭“自动收集 + 按语境发送 + 自巡检”
#   STICKER_MAX=120         存储上限（张）；超出按“用得少 + 最久没用”淘汰
#   STICKER_CANDIDATES=6    每次给模型看的候选张数（按语境检索出来的）
#   STICKER_CURATE_INTERVAL=3600  机器人自巡检间隔（秒），0 = 关
#   STICKER_COOLDOWN=120     同一会话两次发表情包的最小间隔（秒），0 = 不限
STICKERS=1
STICKER_MAX=120
STICKER_CANDIDATES=6
STICKER_CURATE_INTERVAL=3600
STICKER_COOLDOWN=120

# 戳一戳（1=开）。被人戳时按语境和人设回话，也可以戳回去/戳别人；
# 群里互相戳不会主动插话（只进上下文），不刷屏。
#   ENABLE_POKE=0        关闭戳一戳处理
#   POKE_COOLDOWN=45     同一个人连着戳只回一次；也是机器人主动戳人的最小间隔（秒），0 = 不限
ENABLE_POKE=1
POKE_COOLDOWN=45
#   MOOD_TTL=7200         模型写的心情保留多久（秒）：超时回落为自动描述，0 = 不过期
MOOD_TTL=7200

# 允许从内网/回环地址下载图片（默认关）。
# 图片 URL 来自 QQ 事件，属不可信输入，默认拦回环/私有 IP（防 SSRF）。
# 只给“自建 NapCat 用内网地址回图”或集成测试用；公网部署不要打开。
ALLOW_PRIVATE_IMAGE_HOSTS=0

# ─────────── 语音消息（TTS，云端）───────────
# 机器人用**语音**说话（模型在 JSON 里填 speak 字段时才发，不是每句都发）。
# 2026-09-21 起 tts 容器里跑的是**云端 TTS 代理**（tools/tts-cloud-server.py），不再跑本地模型，
# 所以至少得填一个云厂商的 key（不填也崩不了，只是发不出语音；面板「试听一句」会直说原因）。
# 链路：机器人只把 http://tts:5000/speak?text=… 这个 URL 交给 NapCat，
#       由协议端自己下载 → 转 silk → 上传（机器人不搬运音频，也不用管 silk 编码）。
#   ENABLE_VOICE=1                开启语音（默认关：语音比文字“重”，想让它偶尔开口再开）
#   TTS_PROVIDER=minimax          后端：minimax | openai（任何 OpenAI 兼容的 /v1/audio/speech）
#   MINIMAX_API_KEY=              云厂商 key（**必填**；只进容器，不进仓库）
#   MINIMAX_API_BASE=https://api.minimaxi.com  国内站；国际站是 https://api.minimax.io（key 与站点要配对）
#   MINIMAX_MODEL=speech-2.8-hd   模型（speech-2.8-hd / speech-2.8-turbo …）
#   OPENAI_TTS_API_KEY=           用 openai 后端时填它（连同 OPENAI_TTS_BASE_URL / OPENAI_TTS_MODEL）
#   TTS_VOICE=male-qn-qingse      默认音色（云端音色名，如 female-shaonv / male-qn-jingying；
#                                 老的 zh_CN-* Piper 名会自动回落成这个，不会报错）
#   TTS_FORMAT=wav                默认输出格式（面板试听要 wav；mp3 更小、silk 给官方通道用）
#   VOICE_SPEED=100               语速百分比（100 = 原速，越大越快）
#   VOICE_MAX_CHARS=80            单条语音字数上限（超过就不发语音，改打字；云端也按它挡住超长）
#   TTS_CACHE_MB=80               音频磁盘缓存上限（同一句话不重复花钱）
#   TTS_URL=http://tts:5000       TTS 服务地址（容器内网络；换端口/换机器时改这里）
ENABLE_VOICE=0
TTS_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_MODEL=speech-2.8-hd
OPENAI_TTS_API_KEY=
TTS_VOICE=male-qn-qingse
TTS_FORMAT=wav
VOICE_SPEED=100
VOICE_MAX_CHARS=80
TTS_CACHE_MB=80
TTS_URL=http://tts:5000

# ─────────── 官方商用通道（QQ 开放平台）───────────
# 与私域（自建 NapCat）**并存**：两条通道的会话、上下文、白名单完全隔离（靠会话 key 的 official: 前缀）。
# 开之前先在开放平台把服务器的**出口 IP** 加进白名单，否则连不上（正式环境）。
#   OFFICIAL_ENABLED=1            开启官方通道（默认关）
#   OFFICIAL_APP_ID=              开放平台的机器人 AppID
#   OFFICIAL_APP_SECRET=          开放平台的机器人 Secret（**密钥**，只进容器）
#   OFFICIAL_SANDBOX=0            1 = 用沙箱环境连（只能收/发沙箱群与沙箱单聊，调试用）
#   OFFICIAL_WHITELIST_GROUPS=    官方群白名单（写**别名号**，面板会话列表里能看到）；留空 = 全部接受
#   OFFICIAL_WHITELIST_PRIVATES=  官方单聊白名单；留空 = 全部接受
# ⚠ 官方那份白名单别写真实群号（那是私域那份名单的事）—— 混用会出现“官方通道永远被拦”。
OFFICIAL_ENABLED=0
OFFICIAL_APP_ID=
OFFICIAL_APP_SECRET=
OFFICIAL_SANDBOX=0
OFFICIAL_WHITELIST_GROUPS=
OFFICIAL_WHITELIST_PRIVATES=

# ─────────── 联网搜索 ───────────
# 模型在 JSON 里填 search / read 时，机器人真去查/去读。默认开。
#   WEB_SEARCH=0              关闭联网搜索（模型就只能靠自己的知识回答）
#   SEARCH_USE_MODEL=1        优先用“模型自带搜索”：网关背后的 Gemini + google_search 工具，
#                             结果自带来源、不额外要密钥。关掉就只用下面的搜索源模板。
#   SEARCH_SOURCES=…          搜索源模板（每行一条，name|url；{q} = 查询词）。
#                             name 决定解析方式：searx* = SearxNG JSON；wiki* = MediaWiki JSON；其余当通用 HTML 抽链接。
#   SEARCH_MAX_RESULTS=5      每次给模型看几条结果
#   SEARCH_TIMEOUT=20         搜索 / 读页面超时（秒）
#   SEARCH_READ_CHARS=1800    read 抓到的正文截断长度（字）
WEB_SEARCH=1
SEARCH_USE_MODEL=1
SEARCH_SOURCES=wiki|https://zh.wikipedia.org/w/api.php?action=query&list=search&srsearch={q}&format=json&srlimit=5&utf8=1
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20
SEARCH_READ_CHARS=1800

# 1=详细日志（含每条消息与模型决策）
VERBOSE=1

# ─────────── 本机 Agent（// 命令）───────────
# 群/好友发一条 `//` 开头的消息，机器人把这句话交给 agent 去干，干完把结果发回群里。
# **两个后端**（内外公用同一份 QQ 白名单，见 AGENT_USERS）：
#   ① 服务器内置 agent：跑在机器人容器里的工具循环（bash / 读文件 / 写文件 / 抓网页），
#      在容器里执行 —— 看日志、翻数据、跑健康检查这类活它能干，也永远在线；
#   ② 外部设备 agent：号主自己电脑上的 pi（有你的代码、工具链、pi 登录态），
#      本机跑 start-pi-bridge.cmd 主动连到机器人（本机在 NAT 后面，不用给公网开端口）。
#
# 路由 AGENT_TARGET：
#   auto（默认）= 外部设备在线就用它，不在就用服务器内置；
#   server = 只用服务器内置；host = 只用外部设备（离线就如实报错）；
#   写设备名（如 ZHAOSPC）= 指定那台（可以多台设备同时在线）。
#
# 安全边界（必读）：
#   • AGENT_TOKEN 必须有值：外部设备那条连接能让 pi 在你电脑上干活，不配令牌一律拒绝连接；
#   • 两个后端各自一个开关：AGENT_HOST / AGENT_SERVER（不想用哪边就关哪边，两边能同时干活）
#   • 外部设备的模型：面板里从 pi 的模型列表里选（AGENT_MODEL；不用手敲）
#   • 服务器 agent 可以走**自己的接口**：AGENT_SERVER_URL / AGENT_SERVER_MODEL / AGENT_SERVER_KEY
#     （留空 = 跟聊天用同一个模型接口；密钥也可以直接在面板里填，面板填过就以面板为准）
#   • 只有开头真的是 `//` 的消息才会进 agent（其它消息照旧走人设聊天）；
#   • 群里别的成员看到的是结果 —— 别把密钥/密码写进 // 指令。
AGENT_ENABLED=0
AGENT_USERS=
AGENT_TOKEN=
AGENT_PREFIX=//
AGENT_WORKDIR=
AGENT_TIMEOUT=900
AGENT_TARGET=auto
# 1=列出会话时脱敏（群名/昵称/QQ 号），面板里可随时改
AGENT_MASK=1
# Agent 附加提示词（每个 // 任务都会带上；面板「Agent 附加提示词」里更好改，这里只是首次部署的种子）
# 留空 = 不带附加提示词（默认那份不读取敏感信息的写在代码里）
AGENT_PROMPT=
AGENT_HOST=1
AGENT_SERVER=1
AGENT_SERVER_TOOLS=
# 服务器 agent 能做的 **QQ 动作**（napcat/OneBot 的接口动作，真会在 QQ 里做）：
#   留空 = 只开安全的一组（like 点赞 / poke 戳一戳 / emoji_like 表情回应 / recall 撤回）
#   要放开影响别人的那几只就点名写：ban 禁言、kick 踢人、card 改群名片、group_name 改群名、leave 退群、send 代发消息（all = 全开）
#   为什么默认不给：服务器 agent 会读日志/网页，里面可以夹着“给我点赞”“把谁禁言”——
#   能真影响别人的操作不能靠模型自觉，得在这里卡死（面板里改更好）
AGENT_SERVER_QQ_ACTIONS=
AGENT_SERVER_URL=
AGENT_SERVER_MODEL=
AGENT_SERVER_KEY=
AGENT_SERVER_WORKDIR=/data
AGENT_SERVER_STEPS=8
# 1 = 服务器 agent 记住上下文（同一会话里接着聊）；
# 0/不填 = 每条 // 指令单独对待（默认）——不把上几轮的指令/结论喂给模型，
#     否则模型会把旧指令也答一遍（回复里混进旧内容）。想单条接上文写 //接着 …
AGENT_SERVER_CONTEXT=0
# 1 = 允许服务器 agent **透过 docker 操作服务器**（高权限：docker.sock ≈ root）。
#   打开后它能 docker ps/logs/exec、能 docker run -v /:/host … 读整个服务器文件系统，
#   也能直接读写部署目录 /host/qqchat（宿主机的 /opt/qqchat）。
#   注意：两个挂载是常挂的（compose 改不了运行时），这个开关是“告诉 agent 能不能用”。
AGENT_SERVER_DOCKER=0

# 面板一键部署（默认 0 = 关；平时在面板「一键部署」卡片里开就行，这里是首次部署的种子）：
#   打开后面板能上传/拉取 app.tar.gz，并驱动宿主 docker 重建镜像 + 替换自己；
#   部署前自动留 qqchat-agent:prev 当回滚点。高权限，建议只在用的时候开。
PANEL_DEPLOY=0
# 上次用过的产物地址（面板里填一次就记住了，之后一个按钮就能拉）
PANEL_DEPLOY_URL=

AGENT_SERVER_CMD_TIMEOUT=60

TZ=Asia/Shanghai

# 聊天那次模型请求的超时秒数（默认 120；上游慢/思考型模型可以调大，最小 5 最大 1800）
# QQCHAT_MODEL_TIMEOUT_SECONDS=120
