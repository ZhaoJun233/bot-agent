<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BotAgent.Storage</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BotAgent.Core\BotAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BotAgent.Storage" />
    <Using Include="BotAgent.Adapters.Persistence" />
  </ItemGroup>

  <!-- Fixed historical recovery inputs, also shipped by their owning package. -->
  <ItemGroup>
    <EmbeddedResource Include="Schema/host.token-usage.14-15.up.sql" LogicalName="BotAgent.Schema.host.token-usage.14-15.up.sql" />
    <EmbeddedResource Include="Schema/host.token-usage.14-15.down.sql" LogicalName="BotAgent.Schema.host.token-usage.14-15.down.sql" />
    <EmbeddedResource Include="Schema/preset.token-quota.14-15.up.sql" LogicalName="BotAgent.Schema.preset.token-quota.14-15.up.sql" />
    <EmbeddedResource Include="Schema/preset.token-quota.14-15.down.sql" LogicalName="BotAgent.Schema.preset.token-quota.14-15.down.sql" />
  </ItemGroup>

</Project>
