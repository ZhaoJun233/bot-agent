<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BotAgent</RootNamespace>
    <AssemblyName>BotAgent.Headless</AssemblyName>
    <Description>Bot Agent（通用聊天平台 Agent 运行时 / 无界面 / 容器版）：支持 QQ (OneBot/官方)、飞书及本地测试等可插拔聊天平台 + OpenAI 兼容模型驱动。</Description>

    <!-- 容器优化：不变文化 + 只保留英文附属资源，镜像更小 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>true</UseAppHost>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    两个"到处都要用"的适配器命名空间，声明成全局 using（与 ImplicitUsings 的做法一致）：
      · Adapters/Time  —— 时间的进程内入口 Clock（IClock 的唯一实现在那里）；
      · Adapters/Net   —— 出网端口 IHttpFetcher（socket 的唯一构造点在那里）。
    逐个文件加 using 只会在每个文件上多一行噪音（还会顶破行数棘轮）。
    Domain 不许用它们两个（探针有专门一条钉住）。
  -->
  <ItemGroup>
    <Using Include="BotAgent.Adapters.Time" />
    <Using Include="BotAgent.Adapters.Net" />
  </ItemGroup>

  <!--
    登录二维码：面板里直接扫码登录 NapCat。
    选 Net.Codecrete.QrCodeGenerator 而不是更常见的 QRCoder 有具体理由：
      · 零依赖（net6.0/netstandard2.0 都没有 dependency），不会把 System.Drawing.Common
        拖进镜像 —— 那个包在 Linux 上需要 libgdiplus，容器里没有，是运行时地雷。
      · 直接输出 SVG：矢量图在手机上看更锐利，体积也只有 PNG 的几十分之一。
  -->
  <ItemGroup>
    <ProjectReference Include="..\BotAgent.Core\BotAgent.Core.csproj" />
    <ProjectReference Include="..\BotAgent.Platforms\BotAgent.Platforms.csproj" />
    <ProjectReference Include="..\BotAgent.Model\BotAgent.Model.csproj" />
    <ProjectReference Include="..\BotAgent.Engine\BotAgent.Engine.csproj" />
    <ProjectReference Include="..\BotAgent.Mcp\BotAgent.Mcp.csproj" />
    <ProjectReference Include="..\BotAgent.Panel\BotAgent.Panel.csproj" />
    <ProjectReference Include="..\BotAgent.Storage\BotAgent.Storage.csproj" Aliases="StorageModule" />
    <ProjectReference Include="../../tools/BotAgent.PluginBundle/BotAgent.PluginBundle.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/token-quota/backend/BotAgent.Package.TokenQuota.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/websearch/backend/BotAgent.Package.WebSearch.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/poke/backend/BotAgent.Package.Poke.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/vibes/backend/BotAgent.Package.Vibes.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/stickers/backend/BotAgent.Package.Stickers.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/music/backend/BotAgent.Package.Music.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/voice/backend/BotAgent.Package.Voice.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/profiles/backend/BotAgent.Package.Profiles.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/health-reporting/backend/BotAgent.Package.HealthReporting.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/model-services/backend/BotAgent.Package.ModelServices.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/agent/backend/BotAgent.Package.Agent.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/mcp-tools/backend/BotAgent.Package.McpTools.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/conversation/backend/BotAgent.Package.Conversation.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/platform-qq-private/backend/BotAgent.Package.PlatformQqPrivate.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/platform-qq-official/backend/BotAgent.Package.PlatformQqOfficial.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/platform-feishu/backend/BotAgent.Package.PlatformFeishu.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
    <ProjectReference Include="../../packages/platform-local/backend/BotAgent.Package.PlatformLocal.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;RuntimeIdentifier;SelfContained;OutDir;OutputPath;PublishDir" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>

  <Target Name="BuildPluginDistribution" BeforeTargets="BeforeCompile;GetCopyToOutputDirectoryItems;GetCopyToPublishDirectoryItems" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../tools/BotAgent.PluginBundle/bin/$(Configuration)/net10.0/BotAgent.PluginBundle.dll&quot; --output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)plugin-distribution&quot; &quot;$(MSBuildProjectDirectory)/../../packages/token-quota/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/token-quota/backend/bin/$(Configuration)/net10.0/BotAgent.Package.TokenQuota.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/websearch/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/websearch/backend/bin/$(Configuration)/net10.0/BotAgent.Package.WebSearch.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/poke/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/poke/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Poke.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/vibes/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/vibes/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Vibes.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/stickers/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/stickers/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Stickers.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/music/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/music/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Music.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/voice/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/voice/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Voice.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/profiles/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/profiles/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Profiles.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/health-reporting/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/health-reporting/backend/bin/$(Configuration)/net10.0/BotAgent.Package.HealthReporting.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/model-services/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/model-services/backend/bin/$(Configuration)/net10.0/BotAgent.Package.ModelServices.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/agent/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/agent/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Agent.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/mcp-tools/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/mcp-tools/backend/bin/$(Configuration)/net10.0/BotAgent.Package.McpTools.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/conversation/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/conversation/backend/bin/$(Configuration)/net10.0/BotAgent.Package.Conversation.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-qq-private/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-qq-private/backend/bin/$(Configuration)/net10.0/BotAgent.Package.PlatformQqPrivate.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-qq-official/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-qq-official/backend/bin/$(Configuration)/net10.0/BotAgent.Package.PlatformQqOfficial.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-feishu/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-feishu/backend/bin/$(Configuration)/net10.0/BotAgent.Package.PlatformFeishu.dll&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-local/distribution.json&quot; &quot;$(MSBuildProjectDirectory)/../../packages/platform-local/backend/bin/$(Configuration)/net10.0/BotAgent.Package.PlatformLocal.dll&quot;" />
    <ReadLinesFromFile File="$(IntermediateOutputPath)plugin-distribution/bundle-files.txt">
      <Output TaskParameter="Lines" ItemName="_PluginBundleArtifacts" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)plugin-distribution/HostPluginBundle.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)plugin-distribution/HostPluginBundle.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)plugin-distribution/bundle-files.txt" />
      <FileWrites Include="@(_PluginBundleArtifacts->'$(IntermediateOutputPath)plugin-distribution/%(Identity)')" />
      <ContentWithTargetPath Include="@(_PluginBundleArtifacts->'$(IntermediateOutputPath)plugin-distribution/%(Identity)')" TargetPath="plugin-distribution/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
