<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PluginSdkPath)' == ''">
    <ProjectReference Include="../plugin/BotAgent.Plugin.Contracts.csproj" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion" />
  </ItemGroup>
  <ItemGroup Condition="'$(PluginSdkPath)' != ''">
    <Reference Include="BotAgent.Plugin.Contracts" HintPath="$(PluginSdkPath)/BotAgent.Plugin.Contracts.dll" Private="false" />
  </ItemGroup>
</Project>
